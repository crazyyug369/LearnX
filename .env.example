GEMINI_API_KEY=your_gemini_api_key_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=learnx_app
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_DATABASE=learnx_db
FRONTEND_ORIGIN=

# Generate a unique random value of at least 32 characters for each deployment.
JWT_SECRET=replace_with_a_long_random_jwt_secret
ENABLE_LEGACY_AUTH=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_DEMO_SEEDS=false
DEMO_SEED_PASSWORD=
ENABLE_DATASET_SEARCH=false

# Optional public-shell values. These are safe to expose to anonymous visitors
# only when they contain intentionally public information.
VITE_PUBLIC_LAST_UPDATED=
VITE_PUBLIC_SITE_PHRASE=
VITE_PUBLIC_CONTACT_EMAIL=
VITE_PUBLIC_CONTACT_PHONE=
VITE_PUBLIC_CREATOR_URL=
VITE_PUBLIC_CREATOR_LABEL=

# Matching server-rendered values. Leave blank to omit the corresponding UI.
PUBLIC_LAST_UPDATED=
PUBLIC_SITE_PHRASE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CREATOR_URL=
PUBLIC_CREATOR_LABEL=
